# ReelCraft — developer / operator configuration
#
# Copy to `.env` for local development. This file is for developers and operators
# only: customers configure brands, AI providers and preferences inside the app.
# Never commit a real `.env`.

# --- Runtime -------------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                     # true in production (structured JSON logs)

# --- HTTP ----------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Restrict Host headers in production, e.g. app.example.com
TRUSTED_HOSTS=*

# --- Database --------------------------------------------------------------------
# Development default (if unset): SQLite at backend/data/reelcraft.db
# Production (PostgreSQL). Provider URLs work as issued, e.g. Neon's
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=postgresql://reelcraft:CHANGE_ME@localhost:5432/reelcraft
# Apply pending migrations when the API starts. Defaults to true on Vercel, false elsewhere.
# RUN_MIGRATIONS_ON_STARTUP=false

# --- Security ----------------------------------------------------------------------
# Fernet key used to encrypt customer AI keys at rest. REQUIRED in production.
# Generate: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In development a key is generated automatically in backend/data/.encryption_key
# SECRET_ENCRYPTION_KEY=
SESSION_TTL_HOURS=336
ALLOW_PUBLIC_SIGNUP=true
# COOKIE_SECURE=true               # defaults to true in production
GENERATION_RATE_LIMIT_PER_MINUTE=20
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Platform AI (CGM-hosted) -----------------------------------------------------
# Server-side credentials used for customers on "ReelCraft AI". Never sent to browsers.
PLATFORM_AI_PROVIDER=openai        # openai | anthropic | gemini | openrouter | none
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=120
# Point at your own copy to change tier → model mappings without code changes.
# AI_MODEL_CATALOG_PATH=/etc/reelcraft/model_catalog.toml
# Allow customer AI servers on private networks (LM Studio/Ollama). Defaults to
# allowed outside production; keep false for multi-tenant hosting (SSRF protection).
# ALLOW_PRIVATE_AI_URLS=false

# --- Frontend (Vite dev server) ----------------------------------------------------
# VITE_API_PROXY_TARGET=http://127.0.0.1:8000
