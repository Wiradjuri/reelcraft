# Auth (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_here
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Email sign-up (https://resend.com — free tier: 100 emails/day)
RESEND_API_KEY=re_your_resend_api_key

# OpenAI (for live generation, not needed for demo mode)
OPENAI_API_KEY=your_openai_api_key_here

# Demo mode is on by default in the UI and does not call OpenAI.
REELFLOW_DEMO_MODE=true
