# Auth (generate AUTH_SECRET with: openssl rand -base64 32)
AUTH_SECRET=your_auth_secret_here
AUTH_GITHUB_ID=your_github_client_id
AUTH_GITHUB_SECRET=your_github_client_secret
AUTH_GOOGLE_ID=your_google_client_id
AUTH_GOOGLE_SECRET=your_google_client_secret

# Email sign-up (https://resend.com — free tier: 100 emails/day)
RESEND_API_KEY=re_your_resend_api_key
# Sender on a domain verified in Resend. Without it, mail only reaches the Resend account owner.
# RESEND_FROM=ReelFlow <login@yourdomain.com>

# Live text generation. Supported presets: openai, anthropic, nous, grok,
# google, openrouter, lmstudio, and custom.
REELFLOW_TEXT_PROVIDER=openai

# Use the credential for the selected preset. LM Studio is keyless by default.
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# NOUS_API_KEY=your_nous_api_key_here
# XAI_API_KEY=your_xai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# Non-OpenAI providers and LM Studio require an explicit model. These generic
# values override provider-specific *_PLANNING_MODEL and *_COPY_MODEL values.
# REELFLOW_PLANNING_MODEL=your_model_id
# REELFLOW_COPY_MODEL=your_model_id

# Optional endpoint overrides, also used for any OpenAI-compatible custom host.
# REELFLOW_TEXT_BASE_URL=http://127.0.0.1:1234/v1
# REELFLOW_TEXT_API_KEY=optional_generic_key

# Image and speech use a separately configurable OpenAI-compatible media API.
# They default to OPENAI_API_KEY and OpenAI's endpoint when these are omitted.
# REELFLOW_MEDIA_API_KEY=your_media_api_key
# REELFLOW_MEDIA_BASE_URL=https://api.openai.com/v1
# REELFLOW_IMAGE_MODEL=gpt-image-2.5-flare
# REELFLOW_PREMIUM_IMAGE_MODEL=gpt-image-2.5-sunburst
# REELFLOW_TTS_MODEL=gpt-4o-mini-tts

# Demo mode is on by default in the UI and does not call an AI provider.
REELFLOW_DEMO_MODE=true
